# Application
CI_ENVIRONMENT=development
app.baseURL=http://localhost:8080/

# JWT (replace with secure value)
JWT_SECRET=replace-with-strong-random-secret-at-least-32-chars
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# Database
DB_CONNECTION=MySQLi
database.default.hostname=mysql
database.default.database=bys
database.default.username=bys
database.default.password=bys
database.default.DBDriver=MySQLi
database.default.port=3306
database.default.charset=utf8mb4
database.default.DBCollat=utf8mb4_unicode_ci
database.tests.hostname=mysql
database.tests.database=bys
database.tests.username=bys
database.tests.password=bys
database.tests.DBDriver=MySQLi
database.tests.port=3306
database.tests.charset=utf8mb4
database.tests.DBCollat=utf8mb4_unicode_ci

# Redis (if used by cache/session)
REDIS_HOST=redis
REDIS_PORT=6379

# Docker behavior
DOCKER_AUTO_MIGRATE=1

# Optional docs toggle
API_DOCS_ENABLED=true

# Browser SPA (Vite dev server — comma-separated, never "*" in production with Authorization)
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Requested-With,X-Request-ID,Idempotency-Key
CORS_ALLOW_CREDENTIALS=false
